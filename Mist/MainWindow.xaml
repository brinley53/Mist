<Window x:Class="Mist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mist" 
        xmlns:v="clr-namespace:Mist.View"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="480">
    <Window.Resources>
        <v:ImageSourceConverter x:Key="ImageSourceConverter" />
    </Window.Resources>
    <Grid>
        <TextBlock x:Name="HeartrateTextBlock" HorizontalAlignment="Left" Margin="176,106,0,0" TextWrapping="Wrap" Text="{Binding Heartrate.Value}" VerticalAlignment="Top"/>
        <TextBlock x:Name="SoundTextBlock" HorizontalAlignment="Left" Margin="230,120,0,0" TextWrapping="Wrap" Text="{Binding SoundLevel.Value}" VerticalAlignment="Top"/>
        <TextBlock x:Name="LightTextBlock" HorizontalAlignment="Left" Margin="50,30,0,0" TextWrapping="Wrap" Text="{Binding LightLevel.Value}" VerticalAlignment="Top"/>
        <TextBlock x:Name="SkinResistanceTextBlock" HorizontalAlignment="Left" Margin="106,106,0,0" TextWrapping="Wrap" Text="{Binding SkinResistance.Value}" VerticalAlignment="Top"/>
        <TextBlock x:Name="BodyTemperatureTextBlock" HorizontalAlignment="Left" Margin="325,110,0,0" TextWrapping="Wrap" Text="{Binding BodyTemperature.Value}" VerticalAlignment="Top"/>
        <Label Content="Stress Level" HorizontalAlignment="Left" Margin="300,200,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="StressLevel" Text="{Binding StressLevel}" Margin="325, 225,0,0"/>
        <Label Content="Risk Level" HorizontalAlignment="Left" Margin="400,200,0,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="RiskLevel" Text="{Binding RiskLevel}" Margin="420,225,0,0"/>
        <Label Content="{Binding SRT}" HorizontalAlignment="Left" Margin="67,80,0,0" VerticalAlignment="Top"/>
        <Label Content="Light" HorizontalAlignment="Left" Margin="50,10,0,0" VerticalAlignment="Top"/>
        <Label Content="{Binding HRT}" HorizontalAlignment="Left" Margin="163,80,0,0" VerticalAlignment="Top"/>
        <Label Content="Sound" HorizontalAlignment="Left" Margin="206,100,0,0" VerticalAlignment="Top"/>
        <Label Content="{Binding BTT}" HorizontalAlignment="Left" Margin="300,80,0,0" VerticalAlignment="Top"/>
        <Image HorizontalAlignment="Left" Height="179" Margin="112,213,0,0" VerticalAlignment="Top" Width="208" Source="{Binding Path=FerretImage, Converter={StaticResource ImageSourceConverter}}"/>
        <Button Name="HeartInc" Content="Heartrate +" HorizontalAlignment="Left" Margin="67,462,0,0" VerticalAlignment="Top" Command="{Binding HeartIncCommand}"/>
        <Button Name="HeartDec" Content="Heartrate -" HorizontalAlignment="Left" Margin="67,495,0,0" VerticalAlignment="Top" Command="{Binding HeartDecCommand}" RenderTransformOrigin="-0.302,2.023"/>
        <Button Name="ResInc" Content="Resistance +" HorizontalAlignment="Left" Margin="158,495,0,0" VerticalAlignment="Top" Command="{Binding ResIncCommand}"/>
        <Button Name="ResDec" Content="Resistance -" HorizontalAlignment="Left" Margin="156,528,0,0" VerticalAlignment="Top" Command="{Binding ResDecCommand}"/>
        <Button Name="TempInc" Content="Temp +" HorizontalAlignment="Left" Margin="281,485,0,0" VerticalAlignment="Top" Command="{Binding TempIncCommand}"/>
        <Button Name="TempDec" Content="Temp -" HorizontalAlignment="Left" Margin="284,523,0,0" VerticalAlignment="Top" Command="{Binding TempDecCommand}"/>
        <Button Name="SoundInc" Content="Sound +" HorizontalAlignment="Center" Margin="0,581,0,0" VerticalAlignment="Top" Command="{Binding SoundIncCommand}" RenderTransformOrigin="-1.1,5.713"/>
        <Button Name="SoundDec" Content="Sound -" HorizontalAlignment="Left" Margin="219,630,0,0" VerticalAlignment="Top" Command="{Binding SoundDecCommand}"/>
        <Button Name="LightInc" Content="Light +" HorizontalAlignment="Left" Margin="378,475,0,0" VerticalAlignment="Top" Command="{Binding LightIncCommand}"/>
        <Button Name="LightDec" Content="Light -" HorizontalAlignment="Left" Margin="386,508,0,0" VerticalAlignment="Top" Command="{Binding LightDecCommand}"/>
        <TextBlock Name="FerretText" HorizontalAlignment="Left" Margin="157,53,0,0" TextWrapping="Wrap" Text="{Binding FerretText}" VerticalAlignment="Top" Width="120"/>
    </Grid>
</Window>
