<Window x:Class="Mist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mist" 
        xmlns:v="clr-namespace:Mist.View"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="480">
    <Window.Resources>
        <v:ImageSourceConverter x:Key="ImageSourceConverter"/>
        <v:BooleanToVisibilityConverter x:Key="BoolVisConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Name="StressOptions" Margin="0,30,0,0" Height="150" VerticalAlignment="Top" Visibility="{Binding StressTextVisibility, Converter={StaticResource BoolVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>
                <TextBlock Name="FerretText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding FerretText}" Width="120"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="10,0,10,10"/>
                            <Setter Property="Width" Value="75"/>
                            <Setter Property="Height" Value="40"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button Name="Ignore" Command="{Binding ToggleStressTextVisibility}">
                        <TextBlock Text="Tell Rue it's okay." 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   FontSize="10"
                                   Width="40"/>
                    </Button>
                    <Button Name="ListTriggers" Command="{Binding ToggleTriggersVisibility}">
                        <TextBlock Text="See what's bothering Rue." 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   FontSize="10"/>
                    </Button>
                    <Button Name="Activities" Command="{Binding ToggleActivitiesVisibility}">
                        <TextBlock Text="Give Rue attention." 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Image Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Path=FerretImage, Converter={StaticResource ImageSourceConverter}}"/>
            <Grid Grid.Row="1" Margin="25" Background="LightPink" Visibility="{Binding TriggersVisibility, Converter={StaticResource BoolVisConverter}}">
                <ItemsControl ItemsSource="{Binding Triggers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Visibility="{Binding Risk, Converter={StaticResource BoolVisConverter}, ConverterParameter='Collapse'}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid Grid.Row="1" Margin="25" Background="LightGreen" Visibility="{Binding ActivitiesVisibility, Converter={StaticResource BoolVisConverter}}">
                <StackPanel>
                    <TextBlock Text="Mr. Pet wants you to do one of the following with him: "/>
                    <ItemsControl ItemsSource="{Binding Activities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Command="{Binding ActivityCommand}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="25" Background="LightBlue">
                <StackPanel>
                    <TextBlock Text="Choose an activity to edit or create new:"/>
                    <ItemsControl ItemsSource="{Binding Activities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Name="EditActivity" Content="{Binding Name}" Command="{Binding EditActivityCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}" CommandParameter="{Binding}"/> <!-- Path needs to be relative to parent -->
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add New"/>
                </StackPanel>
            </Grid>
            <StackPanel Name="Data" Grid.Column="2" Grid.RowSpan="2">
                <Label Content="{Binding SRT}"/>
                <TextBlock x:Name="SkinResistanceTextBlock" Text="{Binding SkinResistance.Value}"/>
                <Label Content="{Binding HRT}"/>
                <TextBlock x:Name="HeartrateTextBlock" Text="{Binding Heartrate.Value}"/>
                <Label Content="{Binding BTT}"/>
                <TextBlock x:Name="BodyTemperatureTextBlock" Text="{Binding BodyTemperature.Value}"/>
                <Label Content="Stress Level"/>
                <TextBlock x:Name="StressLevel" Text="{Binding StressLevel}"/>
                <Label Content="Sound"/>
                <TextBlock x:Name="SoundTextBlock" Text="{Binding SoundLevel.Value}"/>
                <Label Content="Light"/>
                <TextBlock x:Name="LightTextBlock" Text="{Binding LightLevel.Value}"/>
                <Label Content="Risk Level"/>
                <TextBlock x:Name="RiskLevel" Text="{Binding RiskLevel}"/>
                <Button Content="Edit Activities" /> <!-- On Click, open panel to edit activities-->
            </StackPanel>
        </Grid>
        
        <Grid Name="DataControls" Grid.Row="1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </StackPanel.Resources>
                <StackPanel>
                    <Button Name="HeartInc" Content="Heartrate +" Command="{Binding HeartIncCommand}"/>
                    <Button Name="HeartDec" Content="Heartrate -" Command="{Binding HeartDecCommand}"/>
                </StackPanel>
                <StackPanel>
                    <Button Name="ResInc" Content="Resistance +" Command="{Binding ResIncCommand}"/>
                    <Button Name="ResDec" Content="Resistance -" Command="{Binding ResDecCommand}"/>
                </StackPanel>
                <StackPanel>
                    <Button Name="TempInc" Content="Temp +" Command="{Binding TempIncCommand}"/>
                    <Button Name="TempDec" Content="Temp -" Command="{Binding TempDecCommand}"/>
                </StackPanel>
                <StackPanel>
                    <Button Name="SoundInc" Content="Sound +" Command="{Binding SoundIncCommand}"/>
                    <Button Name="SoundDec" Content="Sound -" Command="{Binding SoundDecCommand}"/>
                </StackPanel>
                <StackPanel>
                    <Button Name="LightInc" Content="Light +" Command="{Binding LightIncCommand}"/>
                    <Button Name="LightDec" Content="Light -" Command="{Binding LightDecCommand}"/>
                </StackPanel>
               
            </StackPanel>
        </Grid>
        <Grid Name="StressEvents" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </StackPanel.Resources>
                <Button Name="Stress1" Content="Stress Event 1" Command="{Binding Stress1Command}"/>
                <Button Name="Stress2" Content="Stress Event 2" Command="{Binding Stress2Command}"/>
                <Button Name="Stress3" Content="Stress Event 3" Command="{Binding Stress3Command}"/>
                <Button Name="SoundRisk" Content="Toggle Sound Risk" Command="{Binding SoundRiskCommand}"/>
                <Button Name="LightRisk" Content="Toggle Light Risk" Command="{Binding LightRiskCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
