<Window x:Class="Mist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mist" 
        xmlns:v="clr-namespace:Mist.View" xmlns:uc="clr-namespace:Mist.View.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="480">
    <Window.Resources>
        <v:ImageSourceConverter x:Key="ImageSourceConverter"/>
        <v:BooleanToVisibilityConverter x:Key="BoolVisConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Name="StressOptions" Margin="0,30,0,0" Height="150" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>
                <TextBlock Name="FerretText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding FerretText}" Width="200" Height="50"  Visibility="{Binding StressTextVisibility, Converter={StaticResource BoolVisConverter}}"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding StressTextVisibility, Converter={StaticResource BoolVisConverter}}">
                    <StackPanel.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="10,0,10,10"/>
                            <Setter Property="Width" Value="75"/>
                            <Setter Property="Height" Value="40"/>
                        </Style>
                    </StackPanel.Resources>
                    <Button Name="Ignore" Command="{Binding ToggleStressTextVisibility}">
                        <TextBlock Text="Tell Rue it's okay." 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   FontSize="10"
                                   Width="40"/>
                    </Button>
                    <Button Name="ListTriggers" Command="{Binding ToggleTriggersVisibility}">
                        <TextBlock Text="Manage Rue's triggers." 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   FontSize="10"/>
                    </Button>
                    <Button Name="Activities" Command="{Binding ToggleActivitiesVisibility}">
                        <TextBlock Text="Give Rue attention." 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Image Grid.Row="1" Height="400" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Path=FerretImage, Converter={StaticResource ImageSourceConverter}}"/>
            <Grid Grid.Row="1" Margin="35" Background="White" VerticalAlignment="Top" Visibility="{Binding TriggersVisibility, Converter={StaticResource BoolVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="Black" BorderThickness="3"/>
                <StackPanel Margin="0,0,25,25">
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="Triggers" FontSize="18" FontWeight="Black"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10" TextWrapping="Wrap" Text="These triggers may be bothering Rue:"/>
                    <ItemsControl ItemsSource="{Binding Triggers}" Margin="10,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ViewTriggerCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}" CommandParameter="{Binding}" 
                                        Content="{Binding Name}" Visibility="{Binding Risk, Converter={StaticResource BoolVisConverter}, ConverterParameter='Collapse'}"
                                        Margin="5" HorizontalAlignment="Left"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.RowSpan="2" Margin="35" Background="White" VerticalAlignment="Top" Visibility="{Binding ActivitiesVisibility, Converter={StaticResource BoolVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="Black" BorderThickness="3"/>
                <StackPanel Margin="0,0,25,25">
                    <TextBlock HorizontalAlignment="Left" Margin="10,10,0,0" Text="Activities" FontSize="18" FontWeight="Black"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10" TextWrapping="Wrap" Text="Rue wants you to do one of the following with her: "/>
                    <ItemsControl ItemsSource="{Binding Activities}" Margin="10,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Command="{Binding ActivityCommand}" Margin="5" HorizontalAlignment="Left"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <!--
            <Grid Grid.Row="1" Margin="25" Background="LightBlue">
                <StackPanel>
                    <TextBlock Text="Choose an activity to edit or create new:"/>
                    <ItemsControl ItemsSource="{Binding Activities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Name="EditActivity" Content="{Binding Name}" Command="{Binding DataContext.EditActivityCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add New"/>
                </StackPanel>
            </Grid>-->
            <StackPanel Name="Data" Grid.Column="2" Grid.RowSpan="2">
                <Label Content="{Binding SRT}"/>
                <TextBlock x:Name="SkinResistanceTextBlock" Text="{Binding SkinResistance.Value}"/>
                <Label Content="{Binding HRT}"/>
                <TextBlock x:Name="HeartrateTextBlock" Text="{Binding Heartrate.Value}"/>
                <Label Content="{Binding BTT}"/>
                <TextBlock x:Name="BodyTemperatureTextBlock" Text="{Binding BodyTemperature.Value}"/>
                <Label Content="Stress Level"/>
                <TextBlock x:Name="StressLevel" Text="{Binding StressLevel}"/>
                <Label Content="Sound"/>
                <TextBlock x:Name="SoundTextBlock" Text="{Binding SoundLevel.Value}"/>
                <Label Content="Light"/>
                <TextBlock x:Name="LightTextBlock" Text="{Binding LightLevel.Value}"/>
                <Label Content="Risk Level"/>
                <TextBlock x:Name="RiskLevel" Text="{Binding RiskLevel}"/>
                <!--<Button Content="Edit Activities" />-->
                <!-- On Click, open panel to edit activities-->
            </StackPanel>
            <uc:PopupUserControl IsViewing="{Binding SelectedActivity.IsViewing}" Title="{Binding SelectedActivity.Name}"
                                 InnerText="Your pet thinks it could be calming to do this activity." Width="315" Grid.Row="1"/>
            <uc:PopupUserControl Items="{Binding SelectedTrigger.Mitigations}" IsViewing="{Binding SelectedTrigger.IsViewing}" Title="{Binding SelectedTrigger.Name}"
                                 InnerText="If this trigger is causing you or your pet distress, try one of these recommended actions:" Width="315" Grid.Row="1"/>
            <!--<uc:TriggerUserControl TriggerData="{Binding SelectedTrigger}" Visibility="{Binding SelectedTrigger.IsViewing, Converter={StaticResource BoolVisConverter}}" Width="300" Grid.Row="1"/>
-->
        </Grid>

        <!--<uc:ActivityUserControl ActivityData="{Binding SelectedActivity}" Visibility="{Binding SelectedActivity.IsEditing, Converter={StaticResource BoolVisConverter}}"/>-->
        <Grid Name="DataControls" Grid.Row="1" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </StackPanel.Resources>
                <StackPanel>
                    <Button Name="HeartInc" Content="Heartrate +" Command="{Binding HeartIncCommand}"/>
                    <Button Name="HeartDec" Content="Heartrate -" Command="{Binding HeartDecCommand}"/>
                </StackPanel>
                <StackPanel>
                    <Button Name="ResInc" Content="Resistance +" Command="{Binding ResIncCommand}"/>
                    <Button Name="ResDec" Content="Resistance -" Command="{Binding ResDecCommand}"/>
                </StackPanel>
                <StackPanel>
                    <Button Name="TempInc" Content="Temp +" Command="{Binding TempIncCommand}"/>
                    <Button Name="TempDec" Content="Temp -" Command="{Binding TempDecCommand}"/>
                </StackPanel>
                <StackPanel>
                    <Button Name="SoundInc" Content="Sound +" Command="{Binding SoundIncCommand}"/>
                    <Button Name="SoundDec" Content="Sound -" Command="{Binding SoundDecCommand}"/>
                </StackPanel>
                <StackPanel>
                    <Button Name="LightInc" Content="Light +" Command="{Binding LightIncCommand}"/>
                    <Button Name="LightDec" Content="Light -" Command="{Binding LightDecCommand}"/>
                </StackPanel>
               
            </StackPanel>
        </Grid>
        <Grid Name="StressEvents" Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </StackPanel.Resources>
                <Button Name="Stress1" Content="Toggle Heart" Command="{Binding Stress1Command}"/>
                <Button Name="Stress2" Content="Toggle Res" Command="{Binding Stress2Command}"/>
                <Button Name="Stress3" Content="Toggle Temp" Command="{Binding Stress3Command}"/>
                <Button Name="SoundRisk" Content="Toggle Sound Risk" Command="{Binding SoundRiskCommand}"/>
                <Button Name="LightRisk" Content="Toggle Light Risk" Command="{Binding LightRiskCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
