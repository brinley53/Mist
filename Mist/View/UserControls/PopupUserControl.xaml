<UserControl x:Class="Mist.View.UserControls.PopupUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mist.View.UserControls"
             xmlns:v="clr-namespace:Mist.View"
             mc:Ignorable="d">
    <UserControl.Resources>
        <v:BooleanToVisibilityConverter x:Key="BoolVisConverter"/>
    </UserControl.Resources>
    <Grid x:Name="Popup" Background="White" VerticalAlignment="Top" Visibility="{Binding IsViewing, Converter={StaticResource BoolVisConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="5"/>
        <Grid Margin="20">
            <StackPanel Margin="0,0,35,0">
                <TextBlock HorizontalAlignment="Left" Margin="5" FontSize="15" FontWeight="Black" TextWrapping="Wrap" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Top" />
                <StackPanel Margin="5">
                    <TextBlock TextWrapping="Wrap" Text="{Binding InnerText, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,5,10"/>
                    <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Click="Close_Click"/>
        </Grid>
    </Grid>
</UserControl>
