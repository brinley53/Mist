<UserControl x:Class="Mist.View.UserControls.TriggerUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Mist.View.UserControls"
             xmlns:v="clr-namespace:Mist.View"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="350">
    <UserControl.Resources>
        <v:BooleanToVisibilityConverter x:Key="BoolVisConverter"/>
    </UserControl.Resources>
    <Grid x:Name="Control" Background="Aquamarine" Visibility="Visible" Height="250" Width="350">
        <TextBlock x:Name="Name" HorizontalAlignment="Left" Margin="38,66,0,0" TextWrapping="Wrap" Text="{Binding TriggerData.Name, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Top" Width="120"/>
        <StackPanel Margin="38,113,0,0" >
            <TextBlock Text="Recommended actions: "/>
            <ItemsControl ItemsSource="{Binding TriggerData.Mitigations, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
        <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Click="Close_Click"/>
    </Grid>
</UserControl>
