<Window x:Class="Mist.View.Activities.DeepBreathingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mist.View.Activities"
        xmlns:v="clr-namespace:Mist.View"
        mc:Ignorable="d"
        Title="DeepBreathingWindow" Height="800" Width="480">
    <Window.Resources>
        <v:ImageSourceConverter x:Key="ImageSourceConverter"/>
        <v:BooleanToVisibilityConverter x:Key="BoolVisConverter"/>
    </Window.Resources>
    <Grid>
        <TextBlock Name="Instruction" Text="{Binding Instruction}" Height="50" Width="100" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,238,0,0"/>
        <TextBlock Name="Time" Text="{Binding Time}" VerticalAlignment="Top" HorizontalAlignment="Center" Height="15" Width="16" Margin="0,315,0,0"/>
        <Button Name="Continue" Content="{Binding ContinueButtonText}" Height="50" Width="75" VerticalAlignment="Top" HorizontalAlignment="Left" Command="{Binding ContinueCommand}" Visibility="{Binding IsExerciseComplete, Converter={StaticResource BoolVisConverter}}" Margin="128,430,0,0"/>
        <Button Name="Exit" Content="Exit" Height="50" Width="75" VerticalAlignment="Top" HorizontalAlignment="Left" Click="CloseButton_Click" Visibility="{Binding IsExerciseComplete, Converter={StaticResource BoolVisConverter}}" Margin="268,430,0,0"/>
    </Grid>
</Window>
