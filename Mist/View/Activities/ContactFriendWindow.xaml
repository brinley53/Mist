<Window x:Class="Mist.View.Activities.ContactFriendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mist.View.Activities"
        xmlns:uc="clr-namespace:Mist.View.UserControls"
        mc:Ignorable="d"
        Title="ContactFriendWindow" Height="800" Width="480">
    <Grid>
        <Image Source="/images/journal.png"/>
        <ScrollViewer Margin="60,0,0,0">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Help Mist write a message to someone close." TextWrapping="Wrap" TextAlignment="Center" FontWeight="DemiBold" FontSize="25" Margin="25"/>
                <uc:FormUserControl x:Name="People" Title="Dear" Text="{Binding People, Mode=TwoWay}" Prompts="{Binding PeoplePrompts}"/>
                <uc:FormUserControl x:Name="Feeling" Title="I feel" Text="{Binding Feeling, Mode=TwoWay}" Prompts="{Binding FeelingPrompts}"/>
                <uc:FormUserControl x:Name="Reason" Title="because of" Text="{Binding Reason, Mode=TwoWay}" Prompts="{Binding ReasonPrompts}"/>
                <uc:FormUserControl x:Name="Action" Title="I need" Text="{Binding Action, Mode=TwoWay}" Prompts="{Binding ActionPrompts}"/>
                <TextBlock Text="Here is the message you created:" TextAlignment="Center" FontSize="20" Margin="20"/>
                <TextBox Text="{Binding Message}" Height="100" Width="350" Margin="10" TextWrapping="Wrap"/>
                <Image Source="/images/ferret_play_0.png" Height="150"/>
                <Button Name="Exit" Content="Exit" Height="50" Width="75" Click="CloseButton_Click" Margin="0,50,0,50"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
