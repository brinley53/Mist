<Window x:Class="Mist.View.Activities.PlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Mist.View.Activities" xmlns:v="clr-namespace:Mist.View"
        mc:Ignorable="d"
        Title="PlayWindow" Height="800" Width="480">
    <Window.Resources>
        <v:ImageSourceConverter x:Key="ImageSourceConverter"/>
        <v:BooleanToVisibilityConverter x:Key="BoolVisConverter"/>
    </Window.Resources>
    <Grid>
        <Image Grid.RowSpan="4" Source="/images/zoom_room.png" Height="1000" Width="600" Margin="-35, -75, 0,0"/>
        <Image x:Name="Fderret" Height="275" Margin="0,0,75,60" VerticalAlignment="Center" Source="/images/ferret_play_0.png."/>

        <Image x:Name="Ferret" Height="275" Margin="0,0,75,60" VerticalAlignment="Center" Source="{Binding FerretImage, Converter={StaticResource ImageSourceConverter}}"/>
        <Image x:Name="Plate" VerticalAlignment="Bottom" Width="300" Margin="0,0,0,-25" Source="/images/plate.png"/>
        <Ellipse x:Name="FerretHitBox" Width="200" Height="100"  Fill="Transparent"
                MouseEnter="ferret_MouseEnter" 
                MouseLeave="ferret_MouseLeave"
                MouseLeftButtonDown="ferret_MouseLeftButtonDown"
                MouseLeftButtonUp="ferret_MouseLeftButtonUp" Margin="90,400,157,303"
                />
        <Rectangle x:Name="FerretHead" Width="40" Height="40"  Fill="Transparent"
            MouseLeftButtonDown="ferret_MouseLeftButtonDown"
            MouseLeftButtonUp="ferret_MouseLeftButtonUp" Margin="315,375,157,342"
            />
        <Canvas x:Name="FoodBowl">
            <Image x:Name="Treat" Source="/images/treat.png" Height="25" Width="25" Canvas.Left="202" Canvas.Top="655" MouseDown="Treat_MouseDown" MouseUp="Treat_MouseUp" MouseMove="Treat_MouseMove" RenderTransformOrigin="1.2,2.669" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Image Source="/images/treat.png" Height="25" Width="25" Canvas.Left="250" Canvas.Top="660" MouseDown="Treat_MouseDown" MouseUp="Treat_MouseUp" MouseMove="Treat_MouseMove" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="1.556,1.914" />
            <Image Source="/images/treat.png" Height="25" Width="25" Canvas.Left="225" Canvas.Top="650" MouseDown="Treat_MouseDown" MouseUp="Treat_MouseUp" MouseMove="Treat_MouseMove" />
            <Image Source="/images/treat.png" Height="25" Width="25" Canvas.Left="240" Canvas.Top="675" MouseDown="Treat_MouseDown" MouseUp="Treat_MouseUp" MouseMove="Treat_MouseMove" />
            <Image Source="/images/treat.png" Height="25" Width="25" Canvas.Left="220" Canvas.Top="670" MouseDown="Treat_MouseDown" MouseUp="Treat_MouseUp" MouseMove="Treat_MouseMove" RenderTransformOrigin="1.6,0.625" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Image Source="/images/treat.png" Height="25" Width="25" Canvas.Left="198" Canvas.Top="680" MouseDown="Treat_MouseDown" MouseUp="Treat_MouseUp" MouseMove="Treat_MouseMove" RenderTransformOrigin="1.6,0.625" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Canvas>
        <Button Name="Continue" Content="Refill Food" Height="50" Width="75" VerticalAlignment="Top" HorizontalAlignment="Left" Click="RefillButton_Click" Visibility="{Binding IsEatingComplete, Converter={StaticResource BoolVisConverter}}" Margin="121,615,0,0"/>
        <Button Name="Exit" Content="Exit" Height="50" Width="75" VerticalAlignment="Top" HorizontalAlignment="Left" Click="CloseButton_Click" Visibility="{Binding IsEatingComplete, Converter={StaticResource BoolVisConverter}}" Margin="275,615,0,0"/>
    </Grid>
</Window>
